# ==============================================================================
# GARAGE BILL MANAGEMENT SYSTEM (GBMS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and populate with your own credentials.
# NEVER commit .env.local with real production or secret keys to version control.
# ==============================================================================

# ─── Database Configuration ──────────────────────────────────────────────────
# Connection string for PostgreSQL (supports Neon Serverless, Supabase, or self-hosted)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# ─── Authentication Credentials ──────────────────────────────────────────────
# Admin login credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YourSecurePasswordHere"

# ─── Security & Sessions ─────────────────────────────────────────────────────
# Cryptographically secure random secret for JWT cookie sessions (min 32 characters)
JWT_SECRET="your-32-character-random-jwt-secret-string-here"

# ─── Application URL ─────────────────────────────────────────────────────────
# Public URL used for generating customer shareable PDF links and webhooks
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Razorpay Payment Gateway ────────────────────────────────────────────────
# Server-only API keys (obtain from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_YourSampleKeyIdHere"
RAZORPAY_KEY_SECRET="YourSampleKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="your_sample_webhook_secret_here"

# Client-side public key (safe for browser bundle)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourSampleKeyIdHere"
